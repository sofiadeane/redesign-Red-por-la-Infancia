{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rpi-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Red-por-la-Infancia",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "rpi-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "-d",
        "Red-por-la-Infancia/out"
      ],
      "port": 4310
    },
    {
      "name": "rpi-explore",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4320",
        "-d",
        "Red-por-la-Infancia"
      ],
      "port": 4320
    }
  ]
}